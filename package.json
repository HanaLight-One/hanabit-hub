{
  "name": "hanabit-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "check": "npm run news:build && npm run notifications:build && npm run dc:build && node --check src/server.mjs && node --check src/config.mjs && node --check public/notification-sw.js && node --check scripts/collect-discord-announcements.mjs && node --check scripts/watch-discord-announcements.mjs && node --check scripts/configure-x-filtered-stream.mjs && node --check scripts/initialize-hub-database.mjs && node --check scripts/publish-news-to-dc.cjs && node --check scripts/publish-dc-compose.cjs && node --test",
    "news:build": "vite build --config vite.news.config.mjs",
    "notifications:build": "vite build --config vite.notifications.config.mjs",
    "dc:build": "vite build --config vite.dc.config.mjs",
    "db:init": "node scripts/initialize-hub-database.mjs",
    "news:discord:check": "node scripts/check-news-discord.mjs",
    "news:discord:test": "node scripts/check-news-discord.mjs --send-log",
    "news:discord:collect": "node scripts/collect-discord-announcements.mjs",
    "news:discord:collect:dry": "node scripts/collect-discord-announcements.mjs --dry-run",
    "news:discord:watch": "node scripts/watch-discord-announcements.mjs",
    "news:x:rules:preview": "node scripts/configure-x-filtered-stream.mjs",
    "news:x:rules:sync": "node scripts/configure-x-filtered-stream.mjs --confirm=sync-hanabit-x-rules"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  }
}
