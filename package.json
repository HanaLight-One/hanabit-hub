{
  "name": "hanabit-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs && node --check src/config.mjs && node --test",
    "news:discord:check": "node scripts/check-news-discord.mjs",
    "news:discord:test": "node scripts/check-news-discord.mjs --send-log"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3"
  }
}
